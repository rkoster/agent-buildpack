#!/usr/bin/env bash
set -euo pipefail

build_dir=${1:?usage: supply BUILD_DIR CACHE_DIR DEPS_DIR INDEX}
cache_dir=${2:?usage: supply BUILD_DIR CACHE_DIR DEPS_DIR INDEX}
deps_dir=${3:?usage: supply BUILD_DIR CACHE_DIR DEPS_DIR INDEX}
index=${4:?usage: supply BUILD_DIR CACHE_DIR DEPS_DIR INDEX}

script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=../dependencies.lock
source "${script_dir}/../dependencies.lock"

if [[ ! -f "${build_dir}/AGENTS.md" ]]; then
  echo "AGENTS.md is required to install the OpenCode agent runtime" >&2
  exit 1
fi

command -v curl >/dev/null || { echo "curl is required during staging" >&2; exit 1; }
command -v sha256sum >/dev/null || { echo "sha256sum is required during staging" >&2; exit 1; }
command -v tar >/dev/null || { echo "tar is required during staging" >&2; exit 1; }

dependency_dir="${deps_dir}/${index}/opencode-agent"
buildpack_config="${deps_dir}/${index}/config.yml"
download_dir="${cache_dir}/opencode-agent"
archive="${download_dir}/opencode-${OPENCODE_VERSION}-linux-x64.tar.gz"
unpack_dir="${download_dir}/unpacked"

mkdir -p "${download_dir}" "${dependency_dir}" "${unpack_dir}"
printf '%s\n' '---' > "${buildpack_config}"

if [[ ! -f "${archive}" ]] || [[ "$(sha256sum "${archive}" | cut -d ' ' -f 1)" != "${OPENCODE_SHA256}" ]]; then
  rm -f "${archive}"
  echo "Downloading OpenCode ${OPENCODE_VERSION}"
  curl --fail --location --retry 3 --silent --show-error "${OPENCODE_URL}" --output "${archive}"
fi

actual_sha=$(sha256sum "${archive}" | cut -d ' ' -f 1)
if [[ "${actual_sha}" != "${OPENCODE_SHA256}" ]]; then
  rm -f "${archive}"
  echo "OpenCode archive checksum mismatch: expected ${OPENCODE_SHA256}, got ${actual_sha}" >&2
  exit 1
fi

rm -rf "${unpack_dir:?}"/*
tar -xzf "${archive}" -C "${unpack_dir}"

binary=$(find "${unpack_dir}" -type f -name opencode -print -quit)
if [[ -z "${binary}" ]]; then
  echo "OpenCode archive did not contain an opencode executable" >&2
  exit 1
fi

install -m 0755 "${binary}" "${dependency_dir}/opencode"
printf '%s\n' "${OPENCODE_VERSION}" > "${dependency_dir}/VERSION"
rm -rf "${unpack_dir}"

runtime_binary="${dependency_dir}/opensandbox-capi"
packaged_runtime="${script_dir}/opensandbox-capi"
if [[ ! -x "${packaged_runtime}" ]]; then
  echo "Packaged OpenSandbox CAPI app facade is missing; run scripts/package.sh before cf push" >&2
  exit 1
fi
install -m 0755 "${packaged_runtime}" "${runtime_binary}"
if [[ ! -x "${script_dir}/opencode-database-setup" ]]; then
  echo "Packaged OpenCode database setup helper is missing; run scripts/package.sh before cf push" >&2
  exit 1
fi
install -m 0755 "${script_dir}/opencode-database-setup" "${dependency_dir}/opencode-database-setup"
if [[ ! -x "${script_dir}/mecatl-runtime" ]]; then
  echo "Packaged Mecatl runtime helper is missing; run scripts/package.sh before cf push" >&2
  exit 1
fi
install -m 0755 "${script_dir}/mecatl-runtime" "${dependency_dir}/mecatl-runtime"

fetch_pinned_archive() {
  local name=$1 url=$2 expected=$3 archive_path=$4
  if [[ ! -f "${archive_path}" ]] || [[ "$(sha256sum "${archive_path}" | cut -d ' ' -f 1)" != "${expected}" ]]; then
    rm -f "${archive_path}"
    echo "Downloading pinned ${name}"
    curl --fail --location --retry 3 --silent --show-error "${url}" --output "${archive_path}"
  fi
  local actual
  actual=$(sha256sum "${archive_path}" | cut -d ' ' -f 1)
  if [[ "${actual}" != "${expected}" ]]; then
    rm -f "${archive_path}"
    echo "${name} archive checksum mismatch: expected ${expected}, got ${actual}" >&2
    exit 1
  fi
}

mecatl_archive="${download_dir}/mecatl-${MECATL_VERSION}-linux-amd64.tar.gz"
node_archive="${download_dir}/node-${NODE_VERSION}-linux-x64.tar.gz"
fetch_pinned_archive "Mecatl ${MECATL_VERSION}" "${MECATL_URL}" "${MECATL_SHA256}" "${mecatl_archive}"
fetch_pinned_archive "Node.js ${NODE_VERSION}" "${NODE_URL}" "${NODE_SHA256}" "${node_archive}"

mecatl_unpack="${download_dir}/mecatl-unpacked"
node_unpack="${download_dir}/node-unpacked"
rm -rf "${mecatl_unpack}" "${node_unpack}"
mkdir -p "${mecatl_unpack}" "${node_unpack}"
tar -xzf "${mecatl_archive}" -C "${mecatl_unpack}" mecated
tar -xzf "${node_archive}" -C "${node_unpack}" --strip-components=2 "node-${NODE_VERSION}-linux-x64/bin/node"
install -m 0755 "${mecatl_unpack}/mecated" "${dependency_dir}/mecated"
install -m 0755 "${node_unpack}/node" "${dependency_dir}/node"
studio_dir="${deps_dir}/${index}/mecatl-studio"
mkdir -p "${studio_dir}"
if [[ ! -d "${script_dir}/../build/studio/app/dist" || ! -d "${script_dir}/../build/studio/app/web/dist" ]]; then
  echo "Packaged Mecatl Studio image assets are missing; run scripts/package.sh before cf push" >&2
  exit 1
fi
cp -a "${script_dir}/../build/studio/app" "${studio_dir}/app"
mkdir -p "${studio_dir}/usr/bin"
install -m 0755 "${dependency_dir}/node" "${studio_dir}/usr/bin/node"
printf '%s\n' "${MECATL_VERSION}" > "${dependency_dir}/MECATL_VERSION"
printf '%s\n' "${NODE_VERSION}" > "${dependency_dir}/NODE_VERSION"
echo "Installed OpenCode ${OPENCODE_VERSION}, Mecatl ${MECATL_VERSION}, and Node.js ${NODE_VERSION}"
